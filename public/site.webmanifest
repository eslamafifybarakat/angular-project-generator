{
  "name": "Angular Project Generator",
  "short_name": "APG",
  "description": "Configure an Angular project, then generate it.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f6fa",
  "theme_color": "#f4f6fa",
  "icons": [
    { "src": "/icons/logo-icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/logo-icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/logo-icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
