# ---------------------------------------------------------------------------
# Example only. Copy to `.env.local` and fill in locally. Never commit either.
# ---------------------------------------------------------------------------
#
# `.env.local` is not in this repository on purpose. A real one is created
# locally, against *this* project's own Vercel project:
#
#   npx vercel link                     # creates .vercel/ (also gitignored)
#   npx vercel env pull .env.local      # writes real values into .env.local
#
# Never copy a `.env.local` or a `.vercel/project.json` from another project.
# Those values are scoped to that project's account and deployment: reusing
# them means a `vercel` command run here could deploy to, or otherwise
# affect, someone else's live site.

# Short-lived token written by `vercel env pull`. Do not hand-write.
VERCEL_OIDC_TOKEN=

# Optional: overrides the site URL used by generate:sitemap and generate:og
# when building outside Vercel. Falls back to the active environment file.
SITE_URL=
